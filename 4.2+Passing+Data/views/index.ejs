<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Name Letters</title>
</head>

<body>

  <!-- using noOfLetters alone will give referenceError because when the page loads for the 1st time noOfLetters is undefined. To eliminate this use locals.var_name -->
  <% if (locals.noOfLetters) { %>
    <h1>There are <%=noOfLetters%> letters in your name</h1>
  <% } else {%>
    <h1>Enter your name below</h1>
  <% } %>
  
  <!-- Write your code here -->
     
   <!--using this will render the value of the variable-->
  <form action="/submit" method="POST">
    <input type="text" name="fName" placeholder="First name">
    <input type="text" name="lName" placeholder="Last name">
    <input type="submit" value="OK">
  </form>
</body>

</html>